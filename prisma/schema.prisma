// Prisma schema for the DXN e-commerce platform
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  DISTRIBUTOR
}

enum DistributorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum CouponType {
  PERCENT
  FIXED
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  ON_BACKORDER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ProductRelationType {
  RELATED
  CROSS_SELL
  UP_SELL
}

enum AttributeType {
  TEXT
  COLOR
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AddressBookLevel {
  PROVINCE
  DISTRICT
  MUNICIPALITY
}

enum MunicipalityType {
  METROPOLITAN
  SUB_METROPOLITAN
  MUNICIPALITY
  RURAL_MUNICIPALITY
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id                    Int        @id @default(autoincrement())
  name                  String
  image                 String?
  email                 String     @unique
  passwordHash          String
  phone                 String?
  role                  Role       @default(USER)
  distributorId         String?    @unique
  distributorApprovedAt DateTime?
  pvBalance             Decimal    @default(0) @db.Decimal(10, 2)
  emailVerified         Boolean    @default(true)
  /// Account-level enable/disable switch (Super Admin capability). Independent of `role`.
  status                UserStatus @default(ACTIVE)
  /// Admin-panel RBAC role. Only meaningful when role === ADMIN. NULL means "legacy/unmanaged
  /// admin — full unrestricted access", so every admin created before this feature (and the
  /// seeded admin@dxn.com prior to seeding) keeps working exactly as before. See requireAdmin().
  adminRoleId           Int?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  addresses               Address[]
  cart                    Cart?
  wishlist                Wishlist?
  orders                  Order[]
  reviews                 Review[]
  notifications           Notification[]
  passwordResetTokens     PasswordResetToken[]
  emailOtps               EmailOtp[]
  distributorApplications DistributorApplication[]     @relation("Applicant")
  reviewedApplications    DistributorApplication[]     @relation("ApplicationReviewer")
  sponsoredApplications   DistributorApplication[]     @relation("Sponsor")
  distributorDiscounts    ProductDistributorDiscount[]
  distributorPvRules      ProductDistributorPv[]
  dealer                  Dealer?
  auditLogs               AuditLog[]
  adminRole               AdminRole?                   @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)
  permissionOverrides     UserPermission[]

  @@index([adminRoleId])
  @@map("user")
}

/// A custom admin-panel role (Super Admin, Admin, Manager, Staff, ...) created by the Super
/// Admin. Governs access to /admin and /api/admin/** only — unrelated to the storefront
/// Distributor/Dealer system. See lib/session.ts requireAdmin()/requirePermission().
model AdminRole {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  description  String?
  /// True only for the single seeded system role. Bypasses all permission checks and can
  /// never be granted through the Roles UI, to guarantee Super Admin can't be locked out.
  isSuperAdmin Boolean  @default(false)
  /// System roles (currently just Super Admin) cannot be deleted or renamed away from isSuperAdmin.
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  permissions AdminRolePermission[]
  users       User[]
  dealers     Dealer[]

  @@map("adminrole")
}

/// Catalog of grantable admin-panel actions, e.g. "products.view". Seeded from lib/permissions.ts.
model Permission {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  module    String
  action    String
  label     String
  createdAt DateTime @default(now())

  roles      AdminRolePermission[]
  userGrants UserPermission[]

  @@index([module])
  @@map("permission")
}

model AdminRolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role       AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("adminrolepermission")
}

/// Per-user permission override on top of their role's permissions. granted=true adds a
/// permission the role doesn't have; granted=false revokes one the role does have.
model UserPermission {
  id           Int      @id @default(autoincrement())
  userId       Int
  permissionId Int
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@map("userpermission")
}

model DistributorApplication {
  id              Int                          @id @default(autoincrement())
  userId          Int
  fullName        String
  phone           String?
  email           String?
  alternatePhone  String?
  reason          String?                      @db.Text
  status          DistributorApplicationStatus @default(PENDING)
  distributorId   String?
  reviewedById    Int?
  reviewedAt      DateTime?
  rejectionReason String?                      @db.Text
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  // Address (optional — legacy applications predate these fields)
  provinceId     Int?
  districtId     Int?
  municipalityId Int?
  wardId         Int?
  toleArea       String?
  fullAddress    String?
  landmark       String?

  // Business information
  businessName          String?
  businessType          String?
  panVatNumber          String?
  registrationNumber    String?
  businessAddress       String?
  businessPhone         String?
  businessEmail         String?
  yearsInBusiness       Int?
  estimatedMonthlySales Decimal? @db.Decimal(12, 2)
  numberOfEmployees     Int?

  // Sponsor — must reference an existing, active Distributor; never free text (see lib/sponsor.ts)
  sponsorDistributorId Int?

  user         User         @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("ApplicationReviewer", fields: [reviewedById], references: [id])
  sponsor      User?        @relation("Sponsor", fields: [sponsorDistributorId], references: [id])
  province     AddressBook? @relation("ApplicationProvince", fields: [provinceId], references: [id])
  district     AddressBook? @relation("ApplicationDistrict", fields: [districtId], references: [id])
  municipality AddressBook? @relation("ApplicationMunicipality", fields: [municipalityId], references: [id])
  ward         Ward?        @relation(fields: [wardId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([sponsorDistributorId])
  @@index([wardId])
  @@map("distributorapplication")
}

model DistributorSequence {
  id        String   @id @default("singleton")
  lastValue Int      @default(100000)
  updatedAt DateTime @updatedAt

  @@map("distributorsequence")
}

model Address {
  id             Int         @id @default(autoincrement())
  userId         Int
  fullName       String
  phone          String
  line1          String
  provinceId     Int
  districtId     Int
  municipalityId Int
  wardNo         Int
  landmark       String?
  addressType    AddressType @default(HOME)
  country        String      @default("Nepal")
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  province     AddressBook @relation("AddressProvince", fields: [provinceId], references: [id])
  district     AddressBook @relation("AddressDistrict", fields: [districtId], references: [id])
  municipality AddressBook @relation("AddressMunicipality", fields: [municipalityId], references: [id])

  @@index([userId])
  @@index([provinceId])
  @@index([districtId])
  @@index([municipalityId])
  @@map("address")
}

model AddressBook {
  id               Int               @id @default(autoincrement())
  parentId         Int?
  level            AddressBookLevel
  name             String
  municipalityType MunicipalityType?
  wardCount        Int?
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())

  parent   AddressBook?  @relation("AddressBookToAddressBook", fields: [parentId], references: [id], onDelete: Cascade)
  children AddressBook[] @relation("AddressBookToAddressBook")

  addressesAsProvince      Address[]                 @relation("AddressProvince")
  addressesAsDistrict      Address[]                 @relation("AddressDistrict")
  addressesAsMunicipality  Address[]                 @relation("AddressMunicipality")
  municipalityShippingRate MunicipalityShippingRate?
  wards                    Ward[]

  applicationsAsProvince     DistributorApplication[] @relation("ApplicationProvince")
  applicationsAsDistrict     DistributorApplication[] @relation("ApplicationDistrict")
  applicationsAsMunicipality DistributorApplication[] @relation("ApplicationMunicipality")

  @@index([parentId])
  @@index([level])
  @@map("addressbook")
}

/// A single ward within a municipality — the finest-grained unit dealer routing operates on.
/// Lazily materialized per (municipality, wardNo): rows are created on demand as an admin
/// assigns a dealer to a ward, rather than pre-seeding every possible ward number up front.
model Ward {
  id             Int      @id @default(autoincrement())
  municipalityId Int
  wardNo         Int
  createdAt      DateTime @default(now())

  municipality AddressBook @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  dealerAssignments DealerWardAssignment[]
  shippingCharges   DealerShippingCharge[]
  applications      DistributorApplication[]
  orders            Order[]
  distancesFrom     WardDistance[]           @relation("WardDistanceFrom")
  distancesTo       WardDistance[]           @relation("WardDistanceTo")

  @@unique([municipalityId, wardNo])
  @@index([municipalityId])
  @@map("ward")
}

/// Admin-configurable ward-to-ward proximity, used to rank alternative dealers when the
/// customer's primary dealer can't fulfill the order (see lib/dealerSelection.ts). Optional:
/// pairs with no row fall back to a same-municipality heuristic rather than blocking checkout.
model WardDistance {
  id         Int @id @default(autoincrement())
  fromWardId Int
  toWardId   Int
  distance   Int

  fromWard Ward @relation("WardDistanceFrom", fields: [fromWardId], references: [id], onDelete: Cascade)
  toWard   Ward @relation("WardDistanceTo", fields: [toWardId], references: [id], onDelete: Cascade)

  @@unique([fromWardId, toWardId])
  @@index([fromWardId])
  @@index([toWardId])
  @@map("warddistance")
}

/// A physical ward-serving fulfillment point. Always backed by an approved Distributor account
/// (userId, unique) rather than a duplicate identity — being a Dealer is a capability granted to
/// an existing Distributor, not a separate signup. Most Distributors are never Dealers.
model Dealer {
  id             Int          @id @default(autoincrement())
  /// Optional — a Dealer may stand alone (no login/portal access) or be backed by an approved
  /// Distributor account (grants that account dealer-portal access to view/ship their orders).
  userId         Int?         @unique
  name           String
  phone          String?
  email          String?
  address        String?
  shippingCharge Decimal      @default(0) @db.Decimal(10, 2)
  status         EntityStatus @default(ACTIVE)
  /// Dealer-portal RBAC role, reusing the same AdminRole/Permission tables as admin users (see
  /// lib/session.ts requireDealerPermission()). NULL (every dealer before this feature) means
  /// full unrestricted access to dealer-portal capabilities — identical to prior behavior.
  adminRoleId    Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user            User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  adminRole       AdminRole?             @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)
  wardAssignments DealerWardAssignment[]
  inventory       DealerInventory[]
  shippingCharges DealerShippingCharge[]
  orders          Order[]

  @@index([status])
  @@index([adminRoleId])
  @@map("dealer")
}

/// Ward -> Dealer routing. `priority` 1 is the primary/deterministic dealer for a ward;
/// `@@unique([wardId, priority])` guarantees exactly one dealer holds any given priority slot
/// per ward (so exactly one primary), while still leaving room for a future priority 2+
/// backup dealer without a schema redesign.
model DealerWardAssignment {
  id        Int      @id @default(autoincrement())
  dealerId  Int
  wardId    Int
  priority  Int      @default(1)
  createdAt DateTime @default(now())

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  ward   Ward   @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([wardId, priority])
  @@index([dealerId])
  @@index([wardId])
  @@map("dealerwardassignment")
}

/// Per-dealer stock, separate from the global Product.stock/ProductVariant.stockQuantity used
/// by the (non-dealer) storefront. Absence of a row means zero stock for that dealer/product.
/// A row is created the first time a Super Admin assigns a central product to a dealer.
/// status ACTIVE = currently assigned/visible to the dealer; INACTIVE = deactivated ("unassigned")
/// without losing the recorded stock. `stock` here is dealer-held stock, entirely separate from
/// the central `Product.stock` (global stock) — updating one must never touch the other.
model DealerInventory {
  id        Int          @id @default(autoincrement())
  dealerId  Int
  productId Int
  variantId Int?
  stock     Int          @default(0)
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  dealer  Dealer          @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([dealerId, productId, variantId])
  @@index([dealerId])
  @@index([productId])
  @@index([status])
  @@map("dealerinventory")
}

/// Ward-specific shipping override for a dealer. A dealer's `Dealer.shippingCharge` is the
/// default; a row here overrides it for one specific ward. No row = use the dealer default.
model DealerShippingCharge {
  id        Int      @id @default(autoincrement())
  dealerId  Int
  wardId    Int
  charge    Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  ward   Ward   @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([dealerId, wardId])
  @@index([dealerId])
  @@index([wardId])
  @@map("dealershippingcharge")
}

/// Generic audit trail for sensitive admin actions (distributor approve/reject, dealer/ward/
/// shipping changes). Kept deliberately simple — a flat event log, not an event-sourced model.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  reason     String?  @db.Text
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@map("auditlog")
}

model Category {
  id               Int          @id @default(autoincrement())
  parentCategoryId Int?
  name             String
  slug             String       @unique
  description      String?      @db.Text
  image            String?
  bannerImage      String?
  icon             String?
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  sortOrder        Int          @default(0)
  isFeatured       Boolean      @default(false)
  status           EntityStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  parent   Category?  @relation("CategoryToCategory", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@index([parentCategoryId])
  @@index([status])
  @@index([deletedAt])
  @@map("category")
}

model Brand {
  id              Int          @id @default(autoincrement())
  name            String
  slug            String       @unique
  logo            String?
  banner          String?
  description     String?      @db.Text
  websiteUrl      String?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  sortOrder       Int          @default(0)
  isFeatured      Boolean      @default(false)
  status          EntityStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  products Product[]

  @@index([status])
  @@index([deletedAt])
  @@map("brand")
}

model Product {
  id         Int     @id @default(autoincrement())
  name       String
  slug       String  @unique
  sku        String? @unique
  categoryId Int
  brandId    Int?

  shortDescription String? @db.Text
  fullDescription  String  @db.Text

  costPrice      Decimal?      @db.Decimal(10, 2)
  price          Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?      @db.Decimal(10, 2)
  discountType   DiscountType?
  discountValue  Decimal?      @db.Decimal(10, 2)
  taxClass       String?

  stock                Int         @default(0)
  lowStockAlert        Int?        @default(5)
  stockStatus          StockStatus @default(IN_STOCK)
  minimumOrderQuantity Int         @default(1)
  maximumOrderQuantity Int?

  weight Decimal? @db.Decimal(10, 3)
  length Decimal? @db.Decimal(10, 2)
  width  Decimal? @db.Decimal(10, 2)
  height Decimal? @db.Decimal(10, 2)

  featuredImage String?

  isFeatured   Boolean @default(false)
  isBestSeller Boolean @default(false)
  isNewArrival Boolean @default(false)
  isOnSale     Boolean @default(false)
  isTrending   Boolean @default(false)
  isSpecial    Boolean @default(false)
  isWeekly     Boolean @default(false)
  isFlash      Boolean @default(false)

  metaTitle       String?
  metaDescription String?
  metaKeywords    String?

  warranty String?
  tags     Json?
  colorway String  @default("green")

  hasDiscount             Boolean  @default(false)
  forCustomer             Boolean  @default(false)
  customerDiscountPercent Decimal? @db.Decimal(5, 2)
  forDistributor          Boolean  @default(false)
  hasPointValue           Boolean  @default(false)

  status      ProductStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  category             Category                     @relation(fields: [categoryId], references: [id])
  brand                Brand?                       @relation(fields: [brandId], references: [id])
  images               ProductImage[]
  variants             ProductVariant[]
  relationsFrom        ProductRelation[]            @relation("ProductRelationsFrom")
  relationsTo          ProductRelation[]            @relation("ProductRelationsTo")
  cartItems            CartItem[]
  wishlistItems        WishlistItem[]
  orderItems           OrderItem[]
  reviews              Review[]
  distributorDiscounts ProductDistributorDiscount[]
  distributorPvRules   ProductDistributorPv[]
  dealerInventory      DealerInventory[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([deletedAt])
  @@map("product")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String?
  alt       String
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("productimage")
}

model ProductRelation {
  id        Int                 @id @default(autoincrement())
  productId Int
  relatedId Int
  type      ProductRelationType
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())

  product Product @relation("ProductRelationsFrom", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("ProductRelationsTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId, type])
  @@index([productId])
  @@index([relatedId])
  @@map("productrelation")
}

model ProductDistributorDiscount {
  id              Int      @id @default(autoincrement())
  productId       Int
  distributorId   Int
  discountPercent Decimal  @db.Decimal(5, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  distributor User    @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@unique([productId, distributorId])
  @@index([productId])
  @@index([distributorId])
  @@map("productdistributordiscount")
}

model ProductDistributorPv {
  id            Int      @id @default(autoincrement())
  productId     Int
  distributorId Int
  pvValue       Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  distributor User    @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@unique([productId, distributorId])
  @@index([productId])
  @@index([distributorId])
  @@map("productdistributorpv")
}

model Attribute {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  slug      String        @unique
  type      AttributeType @default(TEXT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  values AttributeValue[]

  @@map("attribute")
}

model AttributeValue {
  id          Int      @id @default(autoincrement())
  attributeId Int
  value       String
  slug        String
  colorHex    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  attribute     Attribute             @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantValues ProductVariantValue[]

  @@unique([attributeId, value])
  @@index([attributeId])
  @@map("attributevalue")
}

model ProductVariant {
  id             Int          @id @default(autoincrement())
  productId      Int
  sku            String?      @unique
  price          Decimal?     @db.Decimal(10, 2)
  compareAtPrice Decimal?     @db.Decimal(10, 2)
  costPrice      Decimal?     @db.Decimal(10, 2)
  stockQuantity  Int          @default(0)
  lowStockAlert  Int?         @default(5)
  weight         Decimal?     @db.Decimal(10, 3)
  image          String?
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues ProductVariantValue[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  dealerInventory DealerInventory[]

  @@index([productId])
  @@index([status])
  @@index([deletedAt])
  @@map("productvariant")
}

model ProductVariantValue {
  id               Int @id @default(autoincrement())
  variantId        Int
  attributeValueId Int

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeValueId])
  @@index([variantId])
  @@index([attributeValueId])
  @@map("productvariantvalue")
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("cart")
}

model CartItem {
  id        Int  @id @default(autoincrement())
  cartId    Int
  productId Int
  variantId Int?
  quantity  Int  @default(1)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@map("cartitem")
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlist")
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  wishlistId Int
  productId  Int
  variantId  Int?
  createdAt  DateTime @default(now())

  wishlist Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId, variantId])
  @@index([productId])
  @@index([variantId])
  @@map("wishlistitem")
}

model ShippingZone {
  id                   Int      @id @default(autoincrement())
  country              String   @unique
  label                String
  rate                 Decimal  @db.Decimal(10, 2)
  freeShippingMinOrder Decimal? @db.Decimal(10, 2)
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isDefault])
  @@map("shippingzone")
}

model MunicipalityShippingRate {
  id                   Int      @id @default(autoincrement())
  municipalityId       Int      @unique
  label                String?
  rate                 Decimal  @db.Decimal(10, 2)
  freeShippingMinOrder Decimal? @db.Decimal(10, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  municipality AddressBook @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@map("municipalityshippingrate")
}

model TaxRate {
  id        Int      @id @default(autoincrement())
  country   String   @unique
  label     String   @default("VAT")
  percent   Decimal  @db.Decimal(5, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("taxrate")
}

model Coupon {
  id             Int        @id @default(autoincrement())
  code           String     @unique
  type           CouponType
  value          Decimal    @db.Decimal(10, 2)
  minOrderAmount Decimal?   @db.Decimal(10, 2)
  expiresAt      DateTime?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())

  orders Order[]

  @@map("coupon")
}

model Order {
  id          Int    @id @default(autoincrement())
  orderNumber String @unique
  userId      Int

  // shipping snapshot (captured at checkout so later address edits don't rewrite history)
  fullName   String
  phone      String
  email      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String

  // dealer routing — resolved once at checkout and snapshotted so later dealer/ward
  // reassignment or dealer edits never rewrite the history of an already-placed order
  wardId      Int?
  dealerId    Int?
  dealerName  String?
  dealerPhone String?

  subtotal    Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  shippingFee Decimal @default(0) @db.Decimal(10, 2)
  tax         Decimal @default(0) @db.Decimal(10, 2)
  taxLabel    String?
  total       Decimal @db.Decimal(10, 2)
  couponId    Int?

  paymentMethod    PaymentMethod
  paymentSubMethod String?
  paymentStatus    PaymentStatus @default(PENDING)
  paymentReference String?

  status         OrderStatus @default(PROCESSING)
  trackingNumber String?
  courierName    String?

  returnRequested Boolean @default(false)
  returnReason    String?
  refunded        Boolean @default(false)

  totalPv    Decimal @default(0) @db.Decimal(10, 2)
  pvCredited Boolean @default(false)

  placedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                 @relation(fields: [userId], references: [id])
  coupon  Coupon?              @relation(fields: [couponId], references: [id])
  items   OrderItem[]
  history OrderStatusHistory[]
  ward    Ward?                @relation(fields: [wardId], references: [id])
  dealer  Dealer?              @relation(fields: [dealerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([wardId])
  @@index([dealerId])
  @@map("order")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  variantId Int?
  name      String
  image     String?
  price     Decimal @db.Decimal(10, 2)
  quantity  Int

  discountPercent Decimal? @db.Decimal(5, 2)
  pvEarned        Decimal  @default(0) @db.Decimal(10, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id])
  reviews Review[]

  @@index([orderId])
  @@index([productId])
  @@map("orderitem")
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("orderstatushistory")
}

model Review {
  id          Int          @id @default(autoincrement())
  productId   Int
  userId      Int
  orderItemId Int?
  rating      Int
  comment     String       @db.Text
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])

  @@unique([userId, orderItemId])
  @@index([productId])
  @@index([userId])
  @@index([status])
  @@map("review")
}

model HomeBannerSlide {
  id         Int      @id @default(autoincrement())
  title      String
  subtitle   String?
  image      String
  linkUrl    String?
  buttonText String?
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active])
  @@map("homebannerslide")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passwordresettoken")
}

model EmailOtp {
  id        Int      @id @default(autoincrement())
  userId    Int
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("emailotp")
}

model EmailSettings {
  id           String   @id @default("singleton")
  enabled      Boolean  @default(false)
  smtpHost     String?
  smtpPort     Int      @default(587)
  smtpUser     String?
  smtpPassword String?
  secure       Boolean  @default(false)
  fromName     String   @default("DXN")
  fromEmail    String?
  updatedAt    DateTime @updatedAt

  @@map("emailsettings")
}

model PaymentSettings {
  id                String   @id @default("singleton")
  codEnabled        Boolean  @default(true)
  codMinOrderAmount Decimal? @db.Decimal(10, 2)
  codMaxOrderAmount Decimal? @db.Decimal(10, 2)
  esewaEnabled      Boolean  @default(true)
  esewaLogo         String?
  esewaProductCode  String?
  esewaSecretKey    String?
  esewaPaymentUrl   String?
  esewaStatusUrl    String?

  khaltiEnabled   Boolean @default(false)
  khaltiLogo      String?
  khaltiSecretKey String?
  khaltiBaseUrl   String?

  fonepayEnabled         Boolean @default(false)
  fonepayLogo            String?
  fonepayMerchantCode    String?
  fonepaySecretKey       String?
  fonepayCheckoutUrl     String?
  fonepayVerificationUrl String?

  connectipsEnabled       Boolean @default(false)
  connectipsLogo          String?
  connectipsMerchantId    String?
  connectipsAppId         String?
  connectipsAppName       String?
  connectipsPassword      String?
  connectipsPrivateKey    String? @db.Text
  connectipsGatewayUrl    String?
  connectipsValidationUrl String?

  visaEnabled         Boolean @default(false)
  visaLogo            String?
  visaMerchantId      String?
  visaSecretKey       String?
  visaGatewayUrl      String?
  visaVerificationUrl String?

  updatedAt DateTime @updatedAt

  @@map("paymentsettings")
}

model InvoiceSettings {
  id            String   @id @default("singleton")
  companyName   String   @default("DXN")
  addressLine1  String?
  addressLine2  String?
  phone         String?
  email         String?
  taxId         String?
  footerNote    String?  @db.Text
  logo          String?
  invoicePrefix String   @default("INV-")
  updatedAt     DateTime @updatedAt

  @@map("invoicesettings")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  type      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification")
}
