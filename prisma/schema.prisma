generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int                          @id @default(autoincrement())
  name                    String
  email                   String                       @unique(map: "User_email_key")
  passwordHash            String
  phone                   String?
  role                    Role                         @default(USER)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  image                   String?
  distributorApprovedAt   DateTime?
  distributorId           String?                      @unique
  pvBalance               Decimal                      @default(0.00) @db.Decimal(10, 2)
  emailVerified           Boolean                      @default(true)
  /// Account-level enable/disable switch (Super Admin capability). Independent of `role`.
  status                  UserStatus                   @default(ACTIVE)
  /// Admin-panel RBAC role. Only meaningful when role === ADMIN. NULL means "legacy/unmanaged
  /// admin — full unrestricted access", so every admin created before this feature (and the
  /// seeded admin@dxn.com prior to seeding) keeps working exactly as before. See requireAdmin().
  adminRoleId             Int?
  addresses               Address[]
  auditLogs               AuditLog[]
  cart                    Cart?
  dealer                  Dealer?
  reviewedApplications    DistributorApplication[]     @relation("ApplicationReviewer")
  sponsoredApplications   DistributorApplication[]     @relation("Sponsor")
  distributorApplications DistributorApplication[]     @relation("Applicant")
  emailOtps               EmailOtp[]
  notifications           Notification[]
  orders                  Order[]
  passwordResetTokens     PasswordResetToken[]
  distributorDiscounts    ProductDistributorDiscount[]
  distributorPvRules      ProductDistributorPv[]
  reviews                 Review[]
  adminRole               AdminRole?                   @relation(fields: [adminRoleId], references: [id])
  permissionOverrides     UserPermission[]
  wishlist                Wishlist?

  @@index([adminRoleId])
  @@map("user")
}

/// A custom admin-panel role (Super Admin, Admin, Manager, Staff, ...) created by the Super
/// Admin. Governs access to /admin and /api/admin/** only — unrelated to the storefront
/// Distributor/Dealer system. See lib/session.ts requireAdmin()/requirePermission().
model AdminRole {
  id           Int                   @id @default(autoincrement())
  name         String                @unique
  description  String?
  /// True only for the single seeded system role. Bypasses all permission checks and can
  /// never be granted through the Roles UI, to guarantee Super Admin can't be locked out.
  isSuperAdmin Boolean               @default(false)
  /// System roles (currently just Super Admin) cannot be deleted or renamed away from isSuperAdmin.
  isSystem     Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  permissions  AdminRolePermission[]
  dealers      Dealer[]
  users        User[]

  @@map("adminrole")
}

/// Catalog of grantable admin-panel actions, e.g. "products.view". Seeded from lib/permissions.ts.
model Permission {
  id         Int                   @id @default(autoincrement())
  key        String                @unique
  module     String
  action     String
  label      String
  createdAt  DateTime              @default(now())
  roles      AdminRolePermission[]
  userGrants UserPermission[]

  @@index([module])
  @@map("permission")
}

model AdminRolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("adminrolepermission")
}

/// Per-user permission override on top of their role's permissions. granted=true adds a
/// permission the role doesn't have; granted=false revokes one the role does have.
model UserPermission {
  id           Int        @id @default(autoincrement())
  userId       Int
  permissionId Int
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId], map: "userpermission_permissionId_fkey")
  @@map("userpermission")
}

model DistributorApplication {
  id                    Int                          @id @default(autoincrement())
  userId                Int
  fullName              String
  phone                 String?
  reason                String?                      @db.Text
  status                DistributorApplicationStatus @default(PENDING)
  distributorId         String?
  reviewedById          Int?
  reviewedAt            DateTime?
  rejectionReason       String?                      @db.Text
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  alternatePhone        String?
  businessAddress       String?
  businessEmail         String?
  businessName          String?
  businessPhone         String?
  businessType          String?
  districtId            Int?
  email                 String?
  estimatedMonthlySales Decimal?                     @db.Decimal(12, 2)
  fullAddress           String?
  landmark              String?
  municipalityId        Int?
  numberOfEmployees     Int?
  panVatNumber          String?
  provinceId            Int?
  registrationNumber    String?
  sponsorDistributorId  Int?
  toleArea              String?
  wardId                Int?
  yearsInBusiness       Int?
  district              AddressBook?                 @relation("ApplicationDistrict", fields: [districtId], references: [id])
  municipality          AddressBook?                 @relation("ApplicationMunicipality", fields: [municipalityId], references: [id])
  province              AddressBook?                 @relation("ApplicationProvince", fields: [provinceId], references: [id])
  reviewedBy            User?                        @relation("ApplicationReviewer", fields: [reviewedById], references: [id])
  sponsor               User?                        @relation("Sponsor", fields: [sponsorDistributorId], references: [id])
  user                  User                         @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  ward                  Ward?                        @relation(fields: [wardId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([sponsorDistributorId])
  @@index([wardId])
  @@index([districtId], map: "distributorapplication_districtId_fkey")
  @@index([municipalityId], map: "distributorapplication_municipalityId_fkey")
  @@index([provinceId], map: "distributorapplication_provinceId_fkey")
  @@index([reviewedById], map: "distributorapplication_reviewedById_fkey")
  @@map("distributorapplication")
}

model DistributorSequence {
  id        String   @id @default("singleton")
  lastValue Int      @default(100000)
  updatedAt DateTime @updatedAt

  @@map("distributorsequence")
}

model Address {
  id             Int         @id @default(autoincrement())
  userId         Int
  fullName       String
  phone          String
  line1          String
  country        String      @default("Nepal")
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  addressType    AddressType @default(HOME)
  landmark       String?
  municipalityId Int
  provinceId     Int
  wardNo         Int
  districtId     Int
  district       AddressBook @relation("AddressDistrict", fields: [districtId], references: [id], map: "Address_districtId_fkey")
  municipality   AddressBook @relation("AddressMunicipality", fields: [municipalityId], references: [id], map: "Address_municipalityId_fkey")
  province       AddressBook @relation("AddressProvince", fields: [provinceId], references: [id], map: "Address_provinceId_fkey")
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Address_userId_fkey")

  @@index([districtId], map: "Address_districtId_idx")
  @@index([municipalityId], map: "Address_municipalityId_idx")
  @@index([provinceId], map: "Address_provinceId_idx")
  @@index([userId], map: "Address_userId_idx")
  @@map("address")
}

model AddressBook {
  id                         Int                       @id @default(autoincrement())
  parentId                   Int?
  level                      AddressBookLevel
  name                       String
  municipalityType           MunicipalityType?
  wardCount                  Int?
  sortOrder                  Int                       @default(0)
  createdAt                  DateTime                  @default(now())
  addressesAsDistrict        Address[]                 @relation("AddressDistrict")
  addressesAsMunicipality    Address[]                 @relation("AddressMunicipality")
  addressesAsProvince        Address[]                 @relation("AddressProvince")
  parent                     AddressBook?              @relation("AddressBookToAddressBook", fields: [parentId], references: [id], onDelete: Cascade, map: "AddressBook_parentId_fkey")
  children                   AddressBook[]             @relation("AddressBookToAddressBook")
  applicationsAsDistrict     DistributorApplication[]  @relation("ApplicationDistrict")
  applicationsAsMunicipality DistributorApplication[]  @relation("ApplicationMunicipality")
  applicationsAsProvince     DistributorApplication[]  @relation("ApplicationProvince")
  municipalityShippingRate   MunicipalityShippingRate?
  wards                      Ward[]

  @@index([level], map: "AddressBook_level_idx")
  @@index([parentId], map: "AddressBook_parentId_idx")
  @@map("addressbook")
}

/// A single ward within a municipality — the finest-grained unit dealer routing operates on.
/// Lazily materialized per (municipality, wardNo): rows are created on demand as an admin
/// assigns a dealer to a ward, rather than pre-seeding every possible ward number up front.
model Ward {
  id                Int                      @id @default(autoincrement())
  municipalityId    Int
  wardNo            Int
  createdAt         DateTime                 @default(now())
  shippingCharges   DealerShippingCharge[]
  dealerAssignments DealerWardAssignment[]
  applications      DistributorApplication[]
  orders            Order[]
  municipality      AddressBook              @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  distancesFrom     WardDistance[]           @relation("WardDistanceFrom")
  distancesTo       WardDistance[]           @relation("WardDistanceTo")

  @@unique([municipalityId, wardNo])
  @@index([municipalityId])
  @@map("ward")
}

/// Admin-configurable ward-to-ward proximity, used to rank alternative dealers when the
/// customer's primary dealer can't fulfill the order (see lib/dealerSelection.ts). Optional:
/// pairs with no row fall back to a same-municipality heuristic rather than blocking checkout.
model WardDistance {
  id         Int  @id @default(autoincrement())
  fromWardId Int
  toWardId   Int
  distance   Int
  fromWard   Ward @relation("WardDistanceFrom", fields: [fromWardId], references: [id], onDelete: Cascade)
  toWard     Ward @relation("WardDistanceTo", fields: [toWardId], references: [id], onDelete: Cascade)

  @@unique([fromWardId, toWardId])
  @@index([fromWardId])
  @@index([toWardId])
  @@map("warddistance")
}

/// A physical ward-serving fulfillment point. Always backed by an approved Distributor account
/// (userId, unique) rather than a duplicate identity — being a Dealer is a capability granted to
/// an existing Distributor, not a separate signup. Most Distributors are never Dealers.
model Dealer {
  id              Int                    @id @default(autoincrement())
  /// Stable OMS sales-center identity. Dealers are synchronized from OMS.
  salesCenterCode String?                @unique
  /// Optional — a Dealer may stand alone (no login/portal access) or be backed by an approved
  /// Distributor account (grants that account dealer-portal access to view/ship their orders).
  userId          Int?                   @unique
  name            String
  phone           String?
  email           String?
  address         String?
  country         String?
  contactPerson   String?
  shippingCharge  Decimal                @default(0.00) @db.Decimal(10, 2)
  status          EntityStatus           @default(ACTIVE)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  /// Dealer-portal RBAC role, reusing the same AdminRole/Permission tables as admin users (see
  /// lib/session.ts requireDealerPermission()). NULL (every dealer before this feature) means
  /// full unrestricted access to dealer-portal capabilities — identical to prior behavior.
  adminRoleId     Int?
  adminRole       AdminRole?             @relation(fields: [adminRoleId], references: [id])
  user            User?                  @relation(fields: [userId], references: [id])
  inventory       DealerInventory[]
  shippingCharges DealerShippingCharge[]
  wardAssignments DealerWardAssignment[]
  orders          Order[]

  @@index([status])
  @@index([adminRoleId])
  @@map("dealer")
}

/// Ward -> Dealer routing. `priority` 1 is the primary/deterministic dealer for a ward;
/// `@@unique([wardId, priority])` guarantees exactly one dealer holds any given priority slot
/// per ward (so exactly one primary), while still leaving room for a future priority 2+
/// backup dealer without a schema redesign.
model DealerWardAssignment {
  id        Int      @id @default(autoincrement())
  dealerId  Int
  wardId    Int
  priority  Int      @default(1)
  createdAt DateTime @default(now())
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  ward      Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([wardId, priority])
  @@index([dealerId])
  @@index([wardId])
  @@map("dealerwardassignment")
}

/// Per-dealer stock, separate from the global Product.stock/ProductVariant.stockQuantity used
/// by the (non-dealer) storefront. Absence of a row means zero stock for that dealer/product.
/// A row is created the first time a Super Admin assigns a central product to a dealer.
/// status ACTIVE = currently assigned/visible to the dealer; INACTIVE = deactivated ("unassigned")
/// without losing the recorded stock. `stock` here is dealer-held stock, entirely separate from
/// the central `Product.stock` (global stock) — updating one must never touch the other.
model DealerInventory {
  id        Int             @id @default(autoincrement())
  dealerId  Int
  productId Int
  variantId Int?
  stock     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  status    EntityStatus    @default(ACTIVE)
  dealer    Dealer          @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([dealerId, productId, variantId])
  @@index([dealerId])
  @@index([productId])
  @@index([status])
  @@index([variantId], map: "dealerinventory_variantId_fkey")
  @@map("dealerinventory")
}

/// Ward-specific shipping override for a dealer. A dealer's `Dealer.shippingCharge` is the
/// default; a row here overrides it for one specific ward. No row = use the dealer default.
model DealerShippingCharge {
  id        Int      @id @default(autoincrement())
  dealerId  Int
  wardId    Int
  charge    Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  ward      Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([dealerId, wardId])
  @@index([dealerId])
  @@index([wardId])
  @@map("dealershippingcharge")
}

/// Generic audit trail for sensitive admin actions (distributor approve/reject, dealer/ward/
/// shipping changes). Kept deliberately simple — a flat event log, not an event-sourced model.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int
  action     String
  entityType String
  entityId   String?
  oldValue   String?  @db.LongText
  newValue   String?  @db.LongText
  reason     String?  @db.Text
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@map("auditlog")
}

model Category {
  id               Int          @id @default(autoincrement())
  parentCategoryId Int?
  name             String
  slug             String       @unique(map: "Category_slug_key")
  description      String?      @db.Text
  image            String?
  bannerImage      String?
  icon             String?
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  sortOrder        Int          @default(0)
  isFeatured       Boolean      @default(false)
  status           EntityStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?
  parent           Category?    @relation("CategoryToCategory", fields: [parentCategoryId], references: [id], map: "Category_parentCategoryId_fkey")
  children         Category[]   @relation("CategoryToCategory")
  products         Product[]

  @@index([deletedAt], map: "Category_deletedAt_idx")
  @@index([parentCategoryId], map: "Category_parentCategoryId_idx")
  @@index([status], map: "Category_status_idx")
  @@map("category")
}

model Brand {
  id              Int          @id @default(autoincrement())
  name            String
  slug            String       @unique(map: "Brand_slug_key")
  logo            String?
  banner          String?
  description     String?      @db.Text
  websiteUrl      String?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  sortOrder       Int          @default(0)
  isFeatured      Boolean      @default(false)
  status          EntityStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  products        Product[]

  @@index([deletedAt], map: "Brand_deletedAt_idx")
  @@index([status], map: "Brand_status_idx")
  @@map("brand")
}

model Product {
  id                      Int                          @id @default(autoincrement())
  name                    String
  slug                    String                       @unique(map: "Product_slug_key")
  sku                     String?                      @unique(map: "Product_sku_key")
  categoryId              Int
  brandId                 Int?
  shortDescription        String?                      @db.Text
  fullDescription         String                       @db.Text
  costPrice               Decimal?                     @db.Decimal(10, 2)
  price                   Decimal                      @db.Decimal(10, 2)
  compareAtPrice          Decimal?                     @db.Decimal(10, 2)
  discountType            DiscountType?
  discountValue           Decimal?                     @db.Decimal(10, 2)
  taxClass                String?
  stock                   Int                          @default(0)
  lowStockAlert           Int?                         @default(5)
  stockStatus             StockStatus                  @default(IN_STOCK)
  minimumOrderQuantity    Int                          @default(1)
  maximumOrderQuantity    Int?
  weight                  Decimal?                     @db.Decimal(10, 3)
  length                  Decimal?                     @db.Decimal(10, 2)
  width                   Decimal?                     @db.Decimal(10, 2)
  height                  Decimal?                     @db.Decimal(10, 2)
  featuredImage           String?
  isFeatured              Boolean                      @default(false)
  isBestSeller            Boolean                      @default(false)
  isNewArrival            Boolean                      @default(false)
  isOnSale                Boolean                      @default(false)
  isTrending              Boolean                      @default(false)
  metaTitle               String?
  metaDescription         String?
  metaKeywords            String?
  warranty                String?
  tags                    String?                      @db.LongText
  colorway                String                       @default("green")
  status                  ProductStatus                @default(DRAFT)
  publishedAt             DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  deletedAt               DateTime?
  isFlash                 Boolean                      @default(false)
  isSpecial               Boolean                      @default(false)
  isWeekly                Boolean                      @default(false)
  customerDiscountPercent Decimal?                     @db.Decimal(5, 2)
  forCustomer             Boolean                      @default(false)
  forDistributor          Boolean                      @default(false)
  hasDiscount             Boolean                      @default(false)
  hasPointValue           Boolean                      @default(false)
  cartItems               CartItem[]
  dealerInventory         DealerInventory[]
  orderItems              OrderItem[]
  brand                   Brand?                       @relation(fields: [brandId], references: [id], map: "Product_brandId_fkey")
  category                Category                     @relation(fields: [categoryId], references: [id], map: "Product_categoryId_fkey")
  distributorDiscounts    ProductDistributorDiscount[]
  distributorPvRules      ProductDistributorPv[]
  images                  ProductImage[]
  relationsFrom           ProductRelation[]            @relation("ProductRelationsFrom")
  relationsTo             ProductRelation[]            @relation("ProductRelationsTo")
  variants                ProductVariant[]
  reviews                 Review[]
  wishlistItems           WishlistItem[]

  @@index([brandId], map: "Product_brandId_idx")
  @@index([categoryId], map: "Product_categoryId_idx")
  @@index([deletedAt], map: "Product_deletedAt_idx")
  @@index([status], map: "Product_status_idx")
  @@map("product")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String?
  alt       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductImage_productId_fkey")

  @@index([productId], map: "ProductImage_productId_idx")
  @@map("productimage")
}

model ProductRelation {
  id        Int                 @id @default(autoincrement())
  productId Int
  relatedId Int
  type      ProductRelationType
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  product   Product             @relation("ProductRelationsFrom", fields: [productId], references: [id], onDelete: Cascade, map: "ProductRelation_productId_fkey")
  related   Product             @relation("ProductRelationsTo", fields: [relatedId], references: [id], onDelete: Cascade, map: "ProductRelation_relatedId_fkey")

  @@unique([productId, relatedId, type], map: "ProductRelation_productId_relatedId_type_key")
  @@index([productId], map: "ProductRelation_productId_idx")
  @@index([relatedId], map: "ProductRelation_relatedId_idx")
  @@map("productrelation")
}

model ProductDistributorDiscount {
  id              Int      @id @default(autoincrement())
  productId       Int
  distributorId   Int
  discountPercent Decimal  @db.Decimal(5, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  distributor     User     @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, distributorId])
  @@index([productId])
  @@index([distributorId])
  @@map("productdistributordiscount")
}

model ProductDistributorPv {
  id            Int      @id @default(autoincrement())
  productId     Int
  distributorId Int
  pvValue       Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  distributor   User     @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, distributorId])
  @@index([productId])
  @@index([distributorId])
  @@map("productdistributorpv")
}

model Attribute {
  id        Int              @id @default(autoincrement())
  name      String           @unique(map: "Attribute_name_key")
  slug      String           @unique(map: "Attribute_slug_key")
  type      AttributeType    @default(TEXT)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  values    AttributeValue[]

  @@map("attribute")
}

model AttributeValue {
  id            Int                   @id @default(autoincrement())
  attributeId   Int
  value         String
  slug          String
  colorHex      String?
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now())
  attribute     Attribute             @relation(fields: [attributeId], references: [id], onDelete: Cascade, map: "AttributeValue_attributeId_fkey")
  variantValues ProductVariantValue[]

  @@unique([attributeId, value], map: "AttributeValue_attributeId_value_key")
  @@index([attributeId], map: "AttributeValue_attributeId_idx")
  @@map("attributevalue")
}

model ProductVariant {
  id              Int                   @id @default(autoincrement())
  productId       Int
  sku             String?               @unique(map: "ProductVariant_sku_key")
  price           Decimal?              @db.Decimal(10, 2)
  compareAtPrice  Decimal?              @db.Decimal(10, 2)
  costPrice       Decimal?              @db.Decimal(10, 2)
  stockQuantity   Int                   @default(0)
  lowStockAlert   Int?                  @default(5)
  weight          Decimal?              @db.Decimal(10, 3)
  image           String?
  status          EntityStatus          @default(ACTIVE)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?
  cartItems       CartItem[]
  dealerInventory DealerInventory[]
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductVariant_productId_fkey")
  attributeValues ProductVariantValue[]
  wishlistItems   WishlistItem[]

  @@index([deletedAt], map: "ProductVariant_deletedAt_idx")
  @@index([productId], map: "ProductVariant_productId_idx")
  @@index([status], map: "ProductVariant_status_idx")
  @@map("productvariant")
}

model ProductVariantValue {
  id               Int            @id @default(autoincrement())
  variantId        Int
  attributeValueId Int
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade, map: "ProductVariantValue_attributeValueId_fkey")
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, map: "ProductVariantValue_variantId_fkey")

  @@unique([variantId, attributeValueId], map: "ProductVariantValue_variantId_attributeValueId_key")
  @@index([attributeValueId], map: "ProductVariantValue_attributeValueId_idx")
  @@index([variantId], map: "ProductVariantValue_variantId_idx")
  @@map("productvariantvalue")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique(map: "Cart_userId_key")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Cart_userId_fkey")
  items     CartItem[]

  @@map("cart")
}

model CartItem {
  id        Int             @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int             @default(1)
  variantId Int?
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade, map: "CartItem_cartId_fkey")
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade, map: "CartItem_productId_fkey")
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, map: "CartItem_variantId_fkey")

  @@index([cartId], map: "CartItem_cartId_idx")
  @@index([productId], map: "CartItem_productId_idx")
  @@index([variantId], map: "CartItem_variantId_idx")
  @@map("cartitem")
}

model Wishlist {
  id        Int            @id @default(autoincrement())
  userId    Int            @unique(map: "Wishlist_userId_key")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Wishlist_userId_fkey")
  items     WishlistItem[]

  @@map("wishlist")
}

model WishlistItem {
  id         Int             @id @default(autoincrement())
  wishlistId Int
  productId  Int
  variantId  Int?
  createdAt  DateTime        @default(now())
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade, map: "WishlistItem_productId_fkey")
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, map: "WishlistItem_variantId_fkey")
  wishlist   Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade, map: "WishlistItem_wishlistId_fkey")

  @@unique([wishlistId, productId, variantId], map: "WishlistItem_wishlistId_productId_variantId_key")
  @@index([productId], map: "WishlistItem_productId_idx")
  @@index([variantId], map: "WishlistItem_variantId_idx")
  @@map("wishlistitem")
}

model ShippingZone {
  id                   Int      @id @default(autoincrement())
  country              String   @unique(map: "ShippingZone_country_key")
  label                String
  rate                 Decimal  @db.Decimal(10, 2)
  freeShippingMinOrder Decimal? @db.Decimal(10, 2)
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isDefault], map: "ShippingZone_isDefault_idx")
  @@map("shippingzone")
}

model MunicipalityShippingRate {
  id                   Int         @id @default(autoincrement())
  municipalityId       Int         @unique(map: "MunicipalityShippingRate_municipalityId_key")
  label                String?
  rate                 Decimal     @db.Decimal(10, 2)
  freeShippingMinOrder Decimal?    @db.Decimal(10, 2)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  municipality         AddressBook @relation(fields: [municipalityId], references: [id], onDelete: Cascade, map: "MunicipalityShippingRate_municipalityId_fkey")

  @@map("municipalityshippingrate")
}

model TaxRate {
  id        Int      @id @default(autoincrement())
  country   String   @unique(map: "TaxRate_country_key")
  label     String   @default("VAT")
  percent   Decimal  @db.Decimal(5, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)

  @@map("taxrate")
}

model Coupon {
  id             Int        @id @default(autoincrement())
  code           String     @unique(map: "Coupon_code_key")
  type           CouponType
  value          Decimal    @db.Decimal(10, 2)
  minOrderAmount Decimal?   @db.Decimal(10, 2)
  expiresAt      DateTime?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  orders         Order[]

  @@map("coupon")
}

model Order {
  id               Int                  @id @default(autoincrement())
  orderNumber      String               @unique(map: "Order_orderNumber_key")
  userId           Int
  fullName         String
  phone            String
  email            String
  line1            String
  line2            String?
  city             String
  state            String
  postalCode       String
  country          String
  subtotal         Decimal              @db.Decimal(10, 2)
  discount         Decimal              @default(0.00) @db.Decimal(10, 2)
  total            Decimal              @db.Decimal(10, 2)
  couponId         Int?
  paymentMethod    PaymentMethod
  paymentSubMethod String?
  paymentStatus    PaymentStatus        @default(PENDING)
  paymentReference String?
  status           OrderStatus          @default(PROCESSING)
  trackingNumber   String?
  courierName      String?
  returnRequested  Boolean              @default(false)
  returnReason     String?
  refunded         Boolean              @default(false)
  placedAt         DateTime             @default(now())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  shippingFee      Decimal              @default(0.00) @db.Decimal(10, 2)
  tax              Decimal              @default(0.00) @db.Decimal(10, 2)
  taxLabel         String?
  pvCredited       Boolean              @default(false)
  totalPv          Decimal              @default(0.00) @db.Decimal(10, 2)
  dealerId         Int?
  dealerName       String?
  dealerPhone      String?
  wardId           Int?
  coupon           Coupon?              @relation(fields: [couponId], references: [id], map: "Order_couponId_fkey")
  user             User                 @relation(fields: [userId], references: [id], map: "Order_userId_fkey")
  dealer           Dealer?              @relation(fields: [dealerId], references: [id])
  ward             Ward?                @relation(fields: [wardId], references: [id])
  items            OrderItem[]
  history          OrderStatusHistory[]

  @@index([wardId])
  @@index([dealerId])
  @@index([couponId], map: "Order_couponId_fkey")
  @@index([status], map: "Order_status_idx")
  @@index([userId], map: "Order_userId_idx")
  @@map("order")
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int
  productId       Int
  name            String
  image           String?
  price           Decimal  @db.Decimal(10, 2)
  quantity        Int
  variantId       Int?
  discountPercent Decimal? @db.Decimal(5, 2)
  pvEarned        Decimal  @default(0.00) @db.Decimal(10, 2)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "OrderItem_orderId_fkey")
  product         Product  @relation(fields: [productId], references: [id], map: "OrderItem_productId_fkey")
  reviews         Review[]

  @@index([orderId], map: "OrderItem_orderId_idx")
  @@index([productId], map: "OrderItem_productId_idx")
  @@map("orderitem")
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "OrderStatusHistory_orderId_fkey")

  @@index([orderId], map: "OrderStatusHistory_orderId_idx")
  @@map("orderstatushistory")
}

model Review {
  id          Int          @id @default(autoincrement())
  productId   Int
  userId      Int
  orderItemId Int?
  rating      Int
  comment     String       @db.Text
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  orderItem   OrderItem?   @relation(fields: [orderItemId], references: [id], map: "Review_orderItemId_fkey")
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade, map: "Review_productId_fkey")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Review_userId_fkey")

  @@unique([userId, orderItemId], map: "Review_userId_orderItemId_key")
  @@index([orderItemId], map: "Review_orderItemId_fkey")
  @@index([productId], map: "Review_productId_idx")
  @@index([status], map: "Review_status_idx")
  @@index([userId], map: "Review_userId_idx")
  @@map("review")
}

model HomeBannerSlide {
  id         Int      @id @default(autoincrement())
  title      String
  subtitle   String?
  image      String
  linkUrl    String?
  buttonText String?
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active], map: "HomeBannerSlide_active_idx")
  @@map("homebannerslide")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique(map: "PasswordResetToken_tokenHash_key")
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "PasswordResetToken_userId_fkey")

  @@index([userId], map: "PasswordResetToken_userId_idx")
  @@map("passwordresettoken")
}

model EmailOtp {
  id        Int      @id @default(autoincrement())
  userId    Int
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("emailotp")
}

model EmailSettings {
  id           String   @id @default("singleton")
  enabled      Boolean  @default(false)
  smtpHost     String?
  smtpPort     Int      @default(587)
  smtpUser     String?
  smtpPassword String?
  secure       Boolean  @default(false)
  fromName     String   @default("DXN")
  fromEmail    String?
  updatedAt    DateTime @updatedAt

  @@map("emailsettings")
}

model PaymentSettings {
  id                      String   @id @default("singleton")
  codEnabled              Boolean  @default(true)
  codMinOrderAmount       Decimal? @db.Decimal(10, 2)
  codMaxOrderAmount       Decimal? @db.Decimal(10, 2)
  esewaEnabled            Boolean  @default(true)
  esewaProductCode        String?
  esewaSecretKey          String?
  esewaPaymentUrl         String?
  esewaStatusUrl          String?
  updatedAt               DateTime @updatedAt
  esewaLogo               String?
  khaltiEnabled           Boolean  @default(false)
  khaltiLogo              String?
  khaltiSecretKey         String?
  khaltiBaseUrl           String?
  fonepayEnabled          Boolean  @default(false)
  fonepayLogo             String?
  fonepayMerchantCode     String?
